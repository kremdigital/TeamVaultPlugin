# Environment variables read by the build (`esbuild.config.mjs`).
#
# Nothing loads this file automatically: the build reads `process.env` only.
# Set the variable in the shell that runs pnpm, e.g.
#   bash:        TEST_VAULT="/path/to/vault" pnpm build:vault
#   PowerShell:  $env:TEST_VAULT = 'C:\path\to\vault'; pnpm build:vault
# or keep a copy of this file as `.env` (git-ignored) and pass it to Node:
#   node --env-file=.env esbuild.config.mjs --vault

# Root folder of a local Obsidian vault used for development — the folder
# Obsidian opens, not its plugin folder. With `--vault` (`pnpm build:vault`,
# `pnpm dev:vault`) the build copies the three release files — main.js,
# manifest.json and styles.css — into
#   $TEST_VAULT/.obsidian/plugins/team-vault/
# That folder must already exist, and the path assumes the default `.obsidian`
# config folder. Unset, the build skips the copy with a warning.
# Use a test vault bound to a test project: the plugin syncs whatever vault
# it runs in.
TEST_VAULT=/path/to/your/test-vault
